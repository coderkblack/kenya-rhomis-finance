# Kenya RHoMIS Finance API — environment variables
# Copy this file to .env.local and fill in real values.
# DO NOT commit .env.local to version control.

# --- Required ---

# Path to the trained model artifacts directory.
# Default: ../artifacts_kenya (relative to the api/ folder).
# Override this in production if the artifacts are stored elsewhere.
ARTIFACTS_DIR=/absolute/path/to/artifacts_kenya

# Allowed CORS origins for the FastAPI backend.
# Comma-separated list. Example: http://localhost:3000,https://yourapp.example.com
# In production, set this to the actual frontend origin only. Do NOT use * in production.
ALLOWED_ORIGINS=http://localhost:3000
