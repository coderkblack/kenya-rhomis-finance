# Kenya RHoMIS Finance Frontend — environment variables
# Copy this file to .env.local and fill in real values.
# DO NOT commit .env.local to version control.

# --- Required ---

# Groq API key for conversational intake and AI narrative generation.
# ⚠️  ROTATE THIS KEY if it has been exposed in any commit or log.
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Set to "true" to enable the conversational intake feature.
NEXT_PUBLIC_GROQ_ENABLED=true

# Groq model to use for extraction and narrative.
# Default: llama-3.1-8b-instant (fast and cheap).
# Alternatives: llama-3.3-70b-versatile (better quality, slower).
GROQ_MODEL=llama-3.1-8b-instant

# --- Optional ---

# URL of the FastAPI backend.
# Default: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
